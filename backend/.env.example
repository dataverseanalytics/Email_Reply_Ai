# OpenAI API key used to draft replies (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Optional: override the model (default gpt-5.5)
# OPENAI_MODEL=gpt-5.5
# Optional: Fernet key used to encrypt stored mailbox passwords. If unset, one is generated in data/secret.key
# APP_SECRET_KEY=
